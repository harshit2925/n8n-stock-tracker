      "id": "6e269348-bb97-4fea-b526-3578beaa759c",
      "name": "When clicking ‘Execute workflow’"
    },
    {
      "parameters": {
        "jsCode": "// Work out the current results quarter (same logic as reports.js)\nconst now = new Date();\nconst y = now.getFullYear(), m = now.getMonth() + 1;\nlet endMonth, endYear;\nif (m <= 3)      { endMonth = 12; endYear = y - 1; }\nelse if (m <= 6) { endMonth = 3;  endYear = y; }\nelse if (m <= 9) { endMonth = 6;  endYear = y; }\nelse             { endMonth = 9;  endYear = y; }\nconst q = { 6: 1, 9: 2, 12: 3, 3: 4 }[endMonth];\nconst fy = (endMonth === 3 ? endYear : endYear + 1) % 100;\nconst currentQuarter = `Q${q}FY${fy}`;\n\n// Keep stocks that are NOT already Done for this quarter\nconst toCheck = $input.all()\n  .map(item => item.json)\n  .filter(row => !(row.report_status === 'Done' && row.report_quarter === currentQuarter))\n  .map(row => String(row.stock_code || '').trim().toUpperCase())\n  .filter(code => /^[A-Z0-9_-]+$/.test(code)); // safety: only plain stock codes\n\n// Nothing to check? Stop this branch here.\nif (toCheck.length === 0) return [];\n\nreturn [{ json: { codes: toCheck.join(','), count: toCheck.length, quarter: currentQuarter } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        656,
        192
      ],
      "id": "67a52b44-4679-4a18-9021-9ab78ebdc155",
      "name": "Pick stocks to check"
    },
